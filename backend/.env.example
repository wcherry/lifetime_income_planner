DATABASE_URL=lifetime_income_planner.db
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY_HOURS=24
HOST=127.0.0.1
PORT=8080
RUST_LOG=info

# Phase 6: Plaid account aggregation. Leave unset for local dev — endpoints
# that need them return a clear "not configured" error instead of failing.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Phase 6: AI-powered explanations of recommendations. AI_EXPLANATION_PROVIDER
# defaults to "template" (deterministic, no network call). Set it to "claude"
# and provide ANTHROPIC_API_KEY to generate explanations via the Anthropic
# API instead; if the key is missing, requests silently fall back to the
# template provider.
AI_EXPLANATION_PROVIDER=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
